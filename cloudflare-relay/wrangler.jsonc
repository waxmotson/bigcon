{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bigconhosting",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "durable_objects": {
    "bindings": [
      { "name": "BIGCON_ROOMS", "class_name": "BigConRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BigConRoom"] }
  ]
}
